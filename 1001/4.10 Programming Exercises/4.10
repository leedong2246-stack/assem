1. 빅 엔디안에서 리틀 엔디안으로 변환하기 주어진 변수들과 MOV 명령어를 사용하여 bigEndian에 저장된 32비트 16진수 값(12345678h)의 바이트 순서를 뒤집어 littleEndian으로 복사하는 프로그램을 작성하시오.
.data
bigEndian BYTE 12h, 34h, 56h, 78h
littleEndian DWORD ? (값 지정 x)

.code
mov al, [bigEndian + 3]
mov BYTE PTR [littleEndian], al
mov al, [bigEndian + 2]
mov BYTE PTR [littleEndian + 1], al
mov al, [bigEndian + 1]
mov BYTE PTR [littleEndian + 2], al
mov al, [bigEndian]
mov BYTE PTR [littleEndian + 3], al

2. 배열의 인접한 쌍(Pair) 값 교환하기 짝수 개의 요소를 가진 배열에서 반복문과 인덱스 어드레싱을 사용하여 모든 인접한 쌍의 값을 서로 교환하는 프로그램을 작성하시오. (예: 0번 요소와 1번 요소 교환, 2번 요소와 3번 요소 교환 ...)
.data
array DWORD 10h, 20h, 30h, 40h, 50h, 60h   ; 짝수 개 요소

.code
mov ecx, LENGTHOF array / 2
mov esi, 0

L1:
    mov eax, array[esi]
    xchg eax, array[esi + 4]
    mov array[esi], eax
    add esi, 8
    loop L1

3. 배열 요소 간 차이(Gap)의 합 구하기 오름차순으로 정렬된 32비트 정수 배열에서 반복문과 인덱스 어드레싱을 사용하여 인접한 요소 간 차이(Gap)들의 총합을 계산하는 프로그램을 작성하시오. (예: {0, 2, 5, 9, 10}의 차이는 2, 3, 4, 1 이며 총합은 10)

.data
array DWORD 0, 2, 5, 9, 10
sum DWORD 0

.code
mov ecx, LENGTHOF array - 1
mov esi, 0
mov eax, 0

L1:
    mov edx, array[esi + 4]
    sub edx, array[esi]
    add eax, edx
    add esi, TYPE array
    loop L1

mov sum, eax

4. Word(16비트) 배열을 Doubleword(32비트) 배열로 복사하기 반복문을 사용하여 부호 없는 16비트 Word 배열의 모든 요소를 부호 없는 32비트 Doubleword 배열로 복사하는 프로그램을 작성하시오. (MOVZX 활용)
.data
wordArray  WORD  1000h, 2000h, 3000h
dwordArray DWORD LENGTHOF wordArray DUP(?)

.code
mov ecx, LENGTHOF wordArray
mov esi, 0
mov edi, 0

L1:
    movzx eax, wordArray[esi]
    mov dwordArray[edi], eax
    add esi, TYPE wordArray
    add edi, TYPE dwordArray
    loop L1

5. 피보나치 수열 계산하기 반복문을 사용하여 피보나치 수열의 처음 7개 값을 계산하여 배열에 저장하는 프로그램을 작성하시오 (공식: Fib(1) = 1, Fib(2) = 1, Fib(n) = Fib(n – 1) + Fib(n – 2))
.data
fib DWORD 7 DUP(?)

.code
mov fib[0], 1
mov fib[4], 1
mov ecx, 5              ; 계산할 남은 횟수 (7 - 2 = 5)
mov esi, 8              ; fib[2]의 바이트 오프셋 위치

L1:
    mov eax, fib[esi - 4]
    add eax, fib[esi - 8]
    mov fib[esi], eax
    add esi, TYPE fib
    loop L1

6.배열 요소 뒤집기 (In-place) 다른 임시 배열을 사용하지 않고, 간접 또는 인덱스 어드레싱과 반복문을 사용하여 정수 배열의 요소 순서를 제자리(In-place)에서 역순으로 뒤집는 코드를 작성하시오. (추후 배열 크기나 타입이 변경되더라도 동작하도록 SIZEOF, TYPE, LENGTHOF 연산자를 활용하시오.)

.data
array DWORD 1, 2, 3, 4, 5

.code
mov esi, 0
mov edi, SIZEOF array - TYPE array
mov ecx, LENGTHOF array / 2

L1:
    mov eax, array[esi]
    xchg eax, array[edi]
    mov array[esi], eax
    add esi, TYPE array
    sub edi, TYPE array
    loop L1

7. 문자열을 거꾸로 복사하기 반복문과 간접 어드레싱을 사용하여 source 문자열의 문자를 역순으로 읽어 target 문자열에 거꾸로 복사하는 프로그램을 작성하시오. (마지막 널 문자의 위치 처리에 유의)
.data
source BYTE "This is the source string",0
target BYTE SIZEOF source DUP('#')

.code
mov esi, OFFSET source + SIZEOF source - 2  ; null 문자 전 마지막 문자 위치
mov edi, OFFSET target
mov ecx, SIZEOF source - 1                 ; 문자 개수 (null 제외)

L1:
    mov al, [esi]
    mov [edi], al
    dec esi
    inc edi
    loop L1

mov BYTE PTR [edi], 0                      ; target 끝에 null 문자 삽입

8. 배열 요소 오른쪽으로 한 칸씩 회전(Shift)하기 반복문과 인덱스 어드레싱을 사용하여 32비트 정수 배열의 요소들을 오른쪽으로 한 칸씩 이동하는 코드를 작성하시오. 맨 끝에 있는 값은 배열의 맨 앞으로 이동해야 합니다. (예: [10, 20, 30, 40] ➔ [40, 10, 20, 30])
.data
array DWORD 10, 20, 30, 40

.code
mov ecx, LENGTHOF array - 1
mov esi, SIZEOF array - TYPE array
mov eax, array[esi]                         ; 마지막 요소(40) 백업

L1:
    mov edx, array[esi - 4]
    mov array[esi], edx
    sub esi, TYPE array
    loop L1

mov array[0], eax                           ; 백업된 마지막 요소를 맨 앞에 저장

L_LOOP:
    cmp al, [ebx]
    jne L_NEXT
    call NEAR PTR [ebx + 1]
    call Crlf
    jmp L_MENU

L_NEXT:
    add ebx, 5
    loop L_LOOP
    jmp L_MENU

L_EXIT:
    exit
main ENDP

AND_op PROC
    mov edx, OFFSET prompt1
    call WriteString
    call ReadHex
    mov ebx, eax

    mov edx, OFFSET prompt2
    call WriteString
    call ReadHex

    and eax, ebx
    mov edx, OFFSET msgRes
    call WriteString
    call WriteHex
    call Crlf

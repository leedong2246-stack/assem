         BYTE "3. NOT x",0Dh,0Ah
         BYTE "4. x XOR y",0Dh,0Ah
         BYTE "5. Exit program",0Dh,0Ah
         BYTE "Enter choice: ",0

    prompt1 BYTE "Enter first hex integer: ",0
    prompt2 BYTE "Enter second hex integer: ",0
    msgRes BYTE "Result: ",0

    CaseTable BYTE '1'
              DWORD AND_op
              BYTE '2'
              DWORD OR_op
              BYTE '3'
              DWORD NOT_op
              BYTE '4'
              DWORD XOR_op
    EntryCount = 4

.code
main PROC
L_MENU:
    mov edx, OFFSET menu
    call WriteString
    call ReadChar
    call WriteChar
    call Crlf

    cmp al, '5'
    je L_EXIT

    mov ebx, OFFSET CaseTable

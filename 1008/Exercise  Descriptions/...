
1번
[문제] FillArray - 주어진 범위 [j...k] 내의 N개 난수로 32비트 정수 배열을 채우는 프로시저를 작성하시오. 호출 시 배열 포인터, N, j, k 값을 매개변수로 전달하고, 실행 전후 모든 레지스터 값을 보존하시오.
[코드]
INCLUDE Irvine32.inc

.data
    array1 DWORD 10 DUP(?)
    array2 DWORD 5 DUP(?)

.code
FillArray PROC
    pushad
    mov ecx, [esp + 44]
    mov esi, [esp + 48]
    mov eax, [esp + 36]
    sub eax, [esp + 40]
    inc eax
    mov edx, eax

L1:
    mov eax, edx
    call RandomRange
    add eax, [esp + 40]
    mov [esi], eax
    add esi, 4
    loop L1

    popad
    ret 16
FillArray ENDP

main PROC
    call Randomize

    push OFFSET array1
    push 10
    push 10
    push 50
    call FillArray

    push OFFSET array2
    push 5
    push -10
    push 10
    call FillArray

    exit
main ENDP
END main
[해설] 스택을 통해 넘겨받은 범위 [j...k]의 크기 (k - j + 1)를 구한 뒤, `RandomRange`로 난수를 생성하고 시작값 j를 더해 범위 내 난수를 배열 요소로 저장합니다. `pushad`와 `popad`로 레지스터 상태를 보존합니다.

2번
[문제] SumRange - 부호 있는 32비트 정수 배열에서 지정한 범위 [j...k] 내에 속하는 요소들의 합을 구하여 EAX 레지스터로 반환하는 프로시저를 작성하시오.
[코드]
INCLUDE Irvine32.inc

.data
    array SDWORD 10, -5, 20, 30, 15, -12, 0, 25, 40, 5
    count DWORD LENGTHOF array

.code
SumRange PROC
    push ebx
    push ecx
    push edx
    push esi

    mov esi, [esp + 20]
    mov ecx, [esp + 24]
    mov ebx, [esp + 28]
    mov edx, [esp + 32]
    xor eax, eax

L1:
    mov edi, [esi]
    cmp edi, ebx
    jl NEXT
    cmp edi, edx
    jg NEXT
    add eax, edi

NEXT:
    add esi, 4
    loop L1

    pop esi
    pop edx
    pop ecx
    pop ebx
    ret 16
SumRange ENDP

main PROC
    push edx
    push ebx
    push count
    push OFFSET array

    push 50
    push 10
    push count
    push OFFSET array
    call SumRange
    call WriteInt
    call Crlf

    push 30
    push 0
    push count
    push OFFSET array
    call SumRange
    call WriteInt
    call Crlf

    exit
main ENDP
END main
[해설] 배열을 순회하면서 각각의 요소가 최소값 j 미만이거나(`jl NEXT`) 최대값 k 초과인(`jg NEXT`) 경우를 제외하고, 범위 조건 [j...k]을 만족하는 요소만 EAX에 누적 합산합니다.

3번
[문제] CalcGrade - 0~100 사이의 점수를 전달받아 해당 등급 문자('A'~'F')를 AL 레지스터로 반환하는 프로시저를 작성하시오. (90~100: A, 80~89: B, 70~79: C, 60~69: D, 0~59: F)
[코드]
INCLUDE Irvine32.inc

.data
    msg BYTE "Score: ",0
    msg2 BYTE "  Grade: ",0

.code
CalcGrade PROC
    push ebx

    cmp eax, 90
    jge GRADE_A
    cmp eax, 80
    jge GRADE_B
    cmp eax, 70
    jge GRADE_C
    cmp eax, 60
    jge GRADE_D
    mov al, 'F'
    jmp L_END

GRADE_A:
    mov al, 'A'
    jmp L_END
GRADE_B:
    mov al, 'B'
    jmp L_END
GRADE_C:
    mov al, 'C'
    jmp L_END
GRADE_D:
    mov al, 'D'

L_END:
    pop ebx
    ret
CalcGrade ENDP

main PROC
    call Randomize
    mov ecx, 10

L1:
    mov eax, 51
    call RandomRange
    add eax, 50

    mov edx, OFFSET msg
    call WriteString
    call WriteDec

    push eax
    call CalcGrade
    mov bl, al

    mov edx, OFFSET msg2
    call WriteString
    mov al, bl
    call WriteChar
    call Crlf

    pop eax
    loop L1

    exit
main ENDP
END main
[해설] 입력된 점수 EAX를 `cmp` 및 `jge` 명령어로 높은 점수 구간부터 차례대로 비교하여 해당하는 알파벳 성적 문자를 AL 레지스터에 대입합니다.

4번
[문제] College Registration - `.IF` 지시어 대신 `CMP` 및 조건부 점프 명령어를 사용하여 대학 수강 신청 조건 및 이수 학점 유효 범위(1~30)를 검사하는 프로그램을 작성하시오.
[코드]
INCLUDE Irvine32.inc

.data
    prompt1 BYTE "Enter grade average (0-400): ",0
    prompt2 BYTE "Enter credits (1-30): ",0
    errCredit BYTE "Error: Credits must be between 1 and 30.",00ah,00dh,0
    msgOk BYTE "The student can register.",00ah,00dh,0
    msgNo BYTE "The student cannot register.",00ah,00dh,0
    gradeAvg DWORD ?
    credits DWORD ?

.code
main PROC
    mov edx, OFFSET prompt1
    call WriteString
    call ReadInt
    mov gradeAvg, eax

    mov edx, OFFSET prompt2
    call WriteString
    call ReadInt
    mov credits, eax

    cmp credits, 1
    jl ERR
    cmp credits, 30
    jg ERR

    cmp gradeAvg, 350
    jg CAN_REGISTER

    cmp gradeAvg, 250
    jle CHECK_LOW
    cmp credits, 16
    jle CAN_REGISTER
    jmp CANNOT_REGISTER

CHECK_LOW:
    cmp gradeAvg, 200
    jle CANNOT_REGISTER
    cmp credits, 12
    jle CAN_REGISTER
    jmp CANNOT_REGISTER

ERR:
    mov edx, OFFSET errCredit
    call WriteString
    jmp L_END

CAN_REGISTER:
    mov edx, OFFSET msgOk
    call WriteString
    jmp L_END

CANNOT_REGISTER:
    mov edx, OFFSET msgNo
    call WriteString

L_END:
    exit
main ENDP
END main
[해설] 사용자로부터 학점과 평균 성적을 입력받은 후, 학점 수 범위(1~30)를 넘어서면 에러 메시지를 출력합니다. 이후 중첩 조건문을 분기 명령어(`cmp`, `jg`, `jle`)로 구현하여 수강 등록 가능 여부를 판단합니다.

5번
[문제] Boolean Calculator (1) - 불리언 계산기 메뉴를 출력하고 테이블 드라이브 선택(Table-Driven Selection) 기법을 사용하여 사용자가 선택한 연산명을 출력하는 프로그램을 작성하시오.
[코드]
INCLUDE Irvine32.inc

.data
    menu BYTE "1. x AND y",0Dh,0Ah
         BYTE "2. x OR y",0Dh,0Ah
         BYTE "3. NOT x",0Dh,0Ah
         BYTE "4. x XOR y",0Dh,0Ah
         BYTE "5. Exit program",0Dh,0Ah
         BYTE "Enter choice: ",0

    msg1 BYTE "Performing AND operation",0Dh,0Ah,0
    msg2 BYTE "Performing OR operation",0Dh,0Ah,0
    msg3 BYTE "Performing NOT operation",0Dh,0Ah,0
    msg4 BYTE "Performing XOR operation",0Dh,0Ah,0

    CaseTable BYTE '1'
              DWORD Process_AND
              BYTE '2'
              DWORD Process_OR
              BYTE '3'
              DWORD Process_NOT
              BYTE '4'
              DWORD Process_XOR
    EntryCount = 4

.code
main PROC
L_MENU:
    mov edx, OFFSET menu
    call WriteString
    call ReadChar
    call WriteChar
    call Crlf

    cmp al, '5'
    je L_EXIT

    mov ebx, OFFSET CaseTable
    mov ecx, EntryCount

L_LOOP:
    cmp al, [ebx]
    jne L_NEXT
    call NEAR PTR [ebx + 1]
    jmp L_MENU

L_NEXT:
    add ebx, 5
    loop L_LOOP
    jmp L_MENU

L_EXIT:
    exit
main ENDP

Process_AND PROC
    mov edx, OFFSET msg1
    call WriteString
    ret
Process_AND ENDP

Process_OR PROC
    mov edx, OFFSET msg2
    call WriteString
    ret
Process_OR ENDP

Process_NOT PROC
    mov edx, OFFSET msg3
    call WriteString
    ret
Process_NOT ENDP

Process_XOR PROC
    mov edx, OFFSET msg4
    call WriteString
    ret
Process_XOR ENDP

END main
[해설] 선택 메뉴 문자와 해당 연산을 처리할 프로시저의 오프셋 주소를 `CaseTable`에 배열로 저장합니다. 입력받은 문자와 테이블을 비교하여 해당 프로시저 주소를 간접 호출(`call NEAR PTR [ebx+1]`)합니다.


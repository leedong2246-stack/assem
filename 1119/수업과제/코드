.386
.model flat, c
.stack 4096

; Visual Studio C Runtime 및 Win32 라이브러리 연결
includelib ucrt.lib
includelib legacy_stdio_definitions.lib
includelib msvcrt.lib
includelib kernel32.lib

ExitProcess PROTO stdcall, dwExitCode:DWORD
printf      PROTO C, format:PTR BYTE, args:VARARG
scanf       PROTO C, format:PTR BYTE, args:VARARG

.data
    ; 음수 저장을 위해 SDWORD(부호 있는 32비트 정수)로 선언
    num1 SDWORD ?
    num2 SDWORD ?

    sumResult SDWORD ?
    subResult SDWORD ?
    mulResult SDWORD ?
    divResult SDWORD ?
    remResult SDWORD ?

    regAX WORD ?
    regBX WORD ?
    regCX WORD ?
    regDX WORD ?

    ; %d 서식 지정자 사용 (부호 있는 10진수로 입출력)
    fmtIn  BYTE "%d", 0
    fmtStr BYTE "%s", 0

    msg1 BYTE "Enter first number: ", 0
    msg2 BYTE "Enter second number: ", 0

    msgAdd BYTE "Addition: %d", 13, 10, 0
    msgSub BYTE "Subtraction: %d", 13, 10, 0
    msgMul BYTE "Multiplication: %d", 13, 10, 0
    msgDiv BYTE "Division: %d", 13, 10, 0
    msgRem BYTE "Remainder: %d", 13, 10, 0

    msgAX BYTE "AX = %d", 13, 10, 0
    msgBX BYTE "BX = %d", 13, 10, 0
    msgCX BYTE "CX = %d", 13, 10, 0
    msgDX BYTE "DX = %d", 13, 10, 0

.code
main PROC

    ; 1. 첫 번째 정수 입력 (%d)
    INVOKE printf, ADDR fmtStr, ADDR msg1
    INVOKE scanf, ADDR fmtIn, ADDR num1

    ; 2. 두 번째 정수 입력 (%d)
    INVOKE printf, ADDR fmtStr, ADDR msg2
    INVOKE scanf, ADDR fmtIn, ADDR num2

    ; 덧셈
    mov eax, num1
    add eax, num2
    mov sumResult, eax

    ; 뺄셈
    mov eax, num1
    sub eax, num2
    mov subResult, eax

    ; 부호 있는 곱셈 (imul 사용)
    mov eax, num1
    mov ebx, num2
    imul ebx
    mov mulResult, eax

    ; 부호 있는 나눗셈 (cdq + idiv 사용)
    mov eax, num1
    cdq                 ; EAX의 부호 비트를 EDX:EAX로 확장
    mov ebx, num2
    idiv ebx            ; 부호 있는 나눗셈 (EAX: 몫, EDX: 나머지)
    mov divResult, eax
    mov remResult, edx

    ; 레지스터 값 16비트 저장
    mov regAX, ax
    mov regBX, bx
    mov regCX, cx
    mov regDX, dx

    ; 3. 연산 결과 출력 (%d 서식)
    INVOKE printf, ADDR msgAdd, sumResult
    INVOKE printf, ADDR msgSub, subResult
    INVOKE printf, ADDR msgMul, mulResult
    INVOKE printf, ADDR msgDiv, divResult
    INVOKE printf, ADDR msgRem, remResult

    ; 4. 레지스터 내용 출력 (movsx로 부호 확장 후 %d 출력)
    movsx eax, regAX
    INVOKE printf, ADDR msgAX, eax

    movsx eax, regBX
    INVOKE printf, ADDR msgBX, eax

    movsx eax, regCX
    INVOKE printf, ADDR msgCX, eax

    movsx eax, regDX
    INVOKE printf, ADDR msgDX, eax

    INVOKE ExitProcess, 0

main ENDP
END main
